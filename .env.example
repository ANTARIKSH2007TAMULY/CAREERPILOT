PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot
JWT_SECRET=change-me-to-a-strong-secret
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379

# AI provider (Gemini). Leave empty to use local heuristic fallbacks.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash-lite

# AI Usage & Quotas (per-user)
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_REQUEST_LIMIT=300
AI_DAILY_TOKEN_LIMIT=50000
AI_MONTHLY_TOKEN_LIMIT=500000
AI_MAX_REQUEST_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=2000
AI_RATE_LIMIT_PER_MINUTE=5
AI_USAGE_TIMEZONE=UTC

# Job providers
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_MAX_PAGES=20
THEMUSE_API_KEY=
# Safety cap for The Muse. The public API currently serves 100 pages (0-99) and returns 400 after that.
# Leave unset to ingest until the API stops. Do not set this to the advertised page_count (~20k); those pages are not retrievable.
MUSE_MAX_PAGES=500
MUSE_PRIMARY_PAGES=20

# Email (optional). Production sending requires a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=CareerPilot <onboarding@resend.dev>

# Google Calendar OAuth (optional). Redirect URI must match Google Cloud exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/integrations/google/callback
GOOGLE_PROJECT_ID=
