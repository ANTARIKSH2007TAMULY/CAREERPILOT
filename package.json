{
  "name": "careerpilot",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --workspace client run dev",
    "server": "npm --workspace server run dev",
    "seed": "npm --workspace server run seed",
    "build": "npm --workspace client run build",
    "test": "npm --workspace server test && npm --workspace client test",
    "verify:integrations": "npm --workspace server run verify:integrations"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
